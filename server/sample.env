PORT=3000
MONGO_URI=
SECRET_KEY=
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Pagination Configuration
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=100

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Auth Security Configuration
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Email Configuration
# IMPORTANT: Gmail SMTP requires an APP-SPECIFIC PASSWORD, NOT your regular Gmail password
# Steps to get App-Specific Password:
# 1. Go to: https://myaccount.google.com/
# 2. Security → App passwords
# 3. Select "Mail" and "Windows Computer" 
# 4. Google generates a 16-character password - COPY THIS
# 5. Paste the 16-char password below (spaces are normal, nodemailer handles them)
# Example: xxxx xxxx xxxx xxxx (each x is a character or space)

EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

# Token Reset Configuration
PASSWORD_RESET_EXPIRY=24

# Auth Session Configuration
SESSION_DURATION_HOURS=12