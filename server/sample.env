PORT=3000
MONGO_URI=
SECRET_KEY=
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Geocoding Configuration (Address Suggestions + Validation)
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=transport-management-system/1.0
GEOCODING_CONTACT_EMAIL=
GEOCODING_COUNTRY_CODES=in
GEOCODING_TIMEOUT_MS=8000

# Pagination Configuration
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=100

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Auth Security Configuration
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Email Configuration (Gmail API OAuth2)
# MIGRATION: From SMTP to Gmail API OAuth2
# Advantages: Works on cloud hosting without SMTP port blocking
# 
# Setup Steps:
# 1. Visit: https://console.cloud.google.com/
# 2. Create project and enable Gmail API
# 3. Create OAuth2 credentials (Client ID + Secret)
# 4. Set these variables:

EMAIL_AUTH_METHOD=oauth2
EMAIL_USER=your-company-email@gmail.com

# Google OAuth2 Credentials
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# Gmail OAuth2 Token (generated after initial authentication)
# Generate locally: npm run generate-gmail-token
# For production, set this in your deployment platform's environment variables
# Format: {"access_token":"...","refresh_token":"...","expiry_date":...}
GMAIL_OAUTH_TOKEN=

# Legacy SMTP Config (kept for backward compatibility, not used if EMAIL_AUTH_METHOD=oauth2)
# EMAIL_SERVICE=gmail
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_SECURE=true
# EMAIL_PASSWORD=your-app-specific-password

# Token Reset Configuration
PASSWORD_RESET_EXPIRY=24

# Auth Session Configuration
SESSION_DURATION_HOURS=12